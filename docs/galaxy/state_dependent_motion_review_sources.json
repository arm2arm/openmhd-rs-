  "manual_derivation_receipts": [
    {
      "id": "M1",
      "locator": "SM1/SM2; review finding2",
      "argument": "Units and bounded smooth saturation; chi'=30q^2(1-q)^2; C2 join values and stage/domain assumptions."
    },
    {
      "id": "M2",
      "locator": "SM3; finding3",
      "argument": "dC/dt=C_t+C_r[W] at held-fixed real samples; d(Ca)/dt=Cdot*a+C*adot; Wdot belongs to differentiated augmented RHS."
    },
    {
      "id": "M3",
      "locator": "SM4/SM5; finding4",
      "argument": "zP=hL0e0 and vH=hLPeP/2 make aH exactly the old/P Heun trapezoid; final gH recovery is a state-function evaluation."
    },
    {
      "id": "M4",
      "locator": "SM6; finding5",
      "argument": "Constant-U conservative sign proof Q=U(V0+DS)+UDdeltaS=U*Vend; smooth J(t,r) chain rule gives RP=O(h^2), RH=O(h^3) with bounded graph inverse."
    },
    {
      "id": "M5",
      "locator": "SM7; finding6",
      "argument": "Augmented predictor consistency and W_P expansion include W_Y F0; corrector is Heun plus O(h^3), conditional local third/global second order."
    },
    {
      "id": "M6",
      "locator": "SM8; finding1",
      "argument": "rP-rH=-h(WP-W0)/2; dense extension ends at H and P-only faces cannot certify its physical-path coverage."
    },
    {
      "id": "M7",
      "locator": "SM1/SM2, parent S6-S10; findings7-8",
      "argument": "Law-level joint boost uses matching thermodynamics/frames; energy and mean statements are accounting/conditional algebra, not physical stability or consistency."
    }
  ],
