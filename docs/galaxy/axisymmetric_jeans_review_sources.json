  "manual_derivation_receipts": [
    {
      "id": "J1",
      "locator": "J1; review finding2; Y14 p8 Eq24",
      "argument": "vR velocity moment: radial acceleration integration supplies -rho*sphi/R+rho*Phi_R; azimuthal coordinate transport supplies rho*sR/R. Mixed spatial derivative is partial_z(rho*t). vz moment gives partial_R(rho*t)+rho*t/R."
    },
    {
      "id": "J2",
      "locator": "J2; finding3; Y14 p8 Eqs26-32",
      "argument": "Rotate positive principal covariance diag(fR*qprime,qprime), use tan(alpha)=z/R, divide t and sR by sz; denominator R^2+fR*z^2 is positive off origin."
    },
    {
      "id": "J3",
      "locator": "J2 axis paragraph; finding3",
      "argument": "At fixed nonzero z, h/R tends (fR-1)/(fR*z); along z=kR, h tends direction-dependent (fR-1)k/(1+fR*k^2). No uniform origin assignment."
    },
    {
      "id": "J4",
      "locator": "J1/J2 vertical PDE; finding4",
      "argument": "q=rho*sz and rho*t=h*q yield q_z+partial_R(hq)+hq/R+rho*Phi_z=0; not a positivity/existence theorem."
    },
    {
      "id": "J5",
      "locator": "J3-J5; finding1",
      "argument": "For zero tilt, constant b>0 and zero vertical stress at infinity, radial density factor cancels in sz. T=10(delta/DeltaR)^3-15(delta/DeltaR)^4+6(delta/DeltaR)^5 gives partial_R logT=-3/delta+O(1). Positive s0 and bounded derivatives/force imply sphi=-3Rout*b*s0/delta+O(1)."
    },
    {
      "id": "J6",
      "locator": "Parent gravity section10.1; finding5",
      "argument": "Parent leaves disk closure unselected and uses combined softened target; moments/DF/stability and stellar-versus-gas support remain distinct. Satoh streaming cannot repair negative raw total moment."
    }
  ],
